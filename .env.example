# Copy to ".env" and fill in. Everything here is OPTIONAL —
# with none of it set, the bot still runs and prints a headline digest to the console.

# --- LLM (optional: enables real summarization instead of a plain list) ---
# Works with any OpenAI-compatible API.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# xAI / Grok alternative:
# LLM_BASE_URL=https://api.x.ai/v1
# LLM_MODEL=grok-2-latest

# --- Delivery (optional: set one or both, else it prints to console) ---
DISCORD_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# --- Schedule (used by `npm start`) ---
# Default: 8:00 every morning
CRON_SCHEDULE=0 8 * * *
TIMEZONE=Africa/Lagos
